# ------------------------------------------------------------
# ROM Runner - repo-wide ignores
# Goal: keep project settings in git, keep secrets + build output out.
# ------------------------------------------------------------

# --- OS / editor noise ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Environment / secrets ---
.env
.env.*
secrets/
**/*.pem
**/*.key
**/*_key*

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Node / web build ---
node_modules/
dist/
build/
.next/
.out/

# --- Rust / Tauri build ---
target/
src-tauri/target/

# --- IDEs / Editor configs ---
.idea/
.vscode/
.claude/
.codex/
.cursorrules
.cursor/

# --- Local tools / scripts ---
bin/
mcp.json

# --- Cache / temp directories ---
.cache/
.npm/
.cursor/**/.cache/
.cursor/**/cache/
.cursor/**/.tmp/
.claude/_state/
